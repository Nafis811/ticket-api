DATABASE_URL=postgres://postgres:postgres@localhost:5432/tickets
PORT=3000
# Rahasia untuk menandatangani webhook pembayaran (HMAC-SHA256)
WEBHOOK_SECRET=dev-webhook-secret
# Berapa detik pesanan menahan kuota
ORDER_TTL_SECONDS=900
# Seberapa sering worker menandai pesanan kedaluwarsa
EXPIRY_INTERVAL_MS=30000
